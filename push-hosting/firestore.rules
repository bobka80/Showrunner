rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed-in Showrunner clients may read/write live fork data during prep / timeline collab.
    // Session registry meta (_meta) stays GAS-only so open/close cannot be spoofed from the browser.
    // GAS service account writes bypass these rules.
    function isShowrunnerClient() {
      return request.auth != null && request.auth.token.showrunner == true;
    }

    match /projects/{projectId}/assets/{docId} {
      allow read: if request.auth != null;
      allow write: if isShowrunnerClient() && docId != '_meta';
    }
    match /projects/{projectId}/timeline/{docId} {
      allow read: if request.auth != null;
      allow write: if isShowrunnerClient() && docId != '_meta';
    }
    // Campaign Room meta — room open/close stays GAS-owned; Warm Live L2 lets clients
    // update identity fields on meta/state only while status stays open and roomUid/opened* locked.
    // identityWriteSeq must advance by exactly 1 (blocks clock poison / rewrite without seq).
    // name / projectStatus require manager claim (parity with GAS warm save).
    match /projects/{projectId}/meta/{docId} {
      allow read: if request.auth != null;
      allow create, delete: if false;
      allow update: if isShowrunnerClient()
        && docId == 'state'
        && resource.data.status == 'open'
        && request.resource.data.status == resource.data.status
        && request.resource.data.roomUid == resource.data.roomUid
        && request.resource.data.openedAt == resource.data.openedAt
        && request.resource.data.openedBy == resource.data.openedBy
        && request.resource.data.identityWriteSeq == resource.data.get('identityWriteSeq', 0) + 1
        && (
          (request.resource.data.name == resource.data.get('name', '')
            && request.resource.data.projectStatus == resource.data.get('projectStatus', ''))
          || request.auth.token.manager == true
        );
    }
    // Campaign Room R3 — logistics live slice; _meta GAS-only.
    match /projects/{projectId}/logistics/{docId} {
      allow read: if request.auth != null;
      allow write: if isShowrunnerClient() && docId != '_meta';
    }
    // Campaign Room R3d — RFID ops live slice; _meta GAS-only.
    match /projects/{projectId}/ops/{docId} {
      allow read: if request.auth != null;
      allow write: if isShowrunnerClient() && docId != '_meta';
    }
  }
}
